@model WebsiteBanXeMay.Models.ViewModels.SuaThongTinViewModel
@{
    ViewData["Title"] = "Sửa thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="card-header bg-gradient-success text-white p-5 text-center position-relative">
                    <div class="avatar-container position-absolute top-0 start-50 translate-middle-x mt-n5">
                        <div class="avatar bg-gradient-primary rounded-circle d-flex align-items-center justify-content-center shadow-lg">
                            <i class="fas fa-edit fa-3x text-white"></i>
                        </div>
                    </div>
                  
                </div>

                <!-- Form -->
                <form method="post" asp-action="SuaThongTin" class="needs-validation" novalidate>
                    <input type="hidden" asp-for="MaTaiKhoan" />

                    <div class="card-body p-5">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Vui lòng kiểm tra lại thông tin!
                            </div>
                        }

                        <div class="row g-4">
                            <!-- Tên đăng nhập (read-only) -->
                            <div class="col-12">
                                <label class="form-label fw-semibold text-muted">
                                    <i class="fas fa-user me-2 text-primary"></i>@Html.DisplayNameFor(m => m.TenDangNhap)
                                </label>
                                <input asp-for="TenDangNhap" class="form-control bg-light" readonly />
                                <div class="form-text">Tên đăng nhập không thể thay đổi</div>
                            </div>

                            <!-- Họ tên -->
                            <div class="col-md-6">
                                <label asp-for="HoTen" class="form-label fw-semibold"></label>
                                <input asp-for="HoTen" class="form-control" />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <!-- Số ĐT -->
                            <div class="col-md-6">
                                <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                                <input asp-for="SoDienThoai" class="form-control" />
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Địa chỉ -->
                            <div class="col-12">
                                <label asp-for="DiaChi" class="form-label fw-semibold"></label>
                                <textarea asp-for="DiaChi" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="DiaChi" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Buttons -->
                    <div class="card-footer bg-light border-top d-flex justify-content-between p-4">
                        <a asp-action="ThongTin" asp-route-id="@Model.MaTaiKhoan"
                           class="btn btn-outline-secondary btn-lg px-4">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                        <button type="submit" class="btn btn-success btn-lg px-5">
                            <i class="fas fa-save me-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- CSS -->
<style>
    .avatar-container {
        z-index: 10;
    }

    .avatar {
        width: 100px;
        height: 100px;
        border: 5px solid white;
    }

    .form-control:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
    }

    .form-control.is-invalid {
        border-color: #dc3545;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Auto focus first input
        $(document).ready(function() {
            $('input[readonly]:first').next('input').focus();
        });
    </script>
}