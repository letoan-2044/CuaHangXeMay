@model WebsiteBanXeMay.Models.TaiKhoan
@{
    ViewData["Title"] = "Thông tin cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <!-- ALERTS -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm border-0" role="alert">
            <strong>Thành công!</strong> @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm border-0" role="alert">
            <strong>Lỗi!</strong> @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <!-- HEADER -->
            <div class="bg-gradient-primary text-dark rounded-4 p-5 mb-5 shadow-lg text-center">
                <h1 class="display-5 fw-bold mb-3">@(Model.HoTen ?? Model.TenDangNhap ?? "Người dùng")</h1>
                <div class="h4 text-white-50 mb-4">ID: #@Model.MaTaiKhoan</div>

                <!-- BADGES -->
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <span class="badge fs-5 px-4 py-3 fw-semibold bg-light text-dark border">
                        @(Model.ChucVu?.TenChucVu ?? "Khách hàng")
                    </span>
                    <span class="badge fs-5 px-4 py-3 fw-semibold @(Model.TrangThai ? "bg-success bg-opacity-20" : "bg-danger bg-opacity-20")">
                        @(Model.TrangThai ? "Hoạt động" : "Bị khóa")
                    </span>
                </div>
            </div>

            <!-- INFO GRID -->
            <div class="row g-4 mb-5">
                <!-- CỘT 1 -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100 rounded-3">
                        <div class="card-header bg-light border-bottom py-3">
                            <h6 class="fw-bold mb-0 text-primary">Thông tin cơ bản</h6>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-4">
                                <small class="text-muted fw-semibold d-block mb-2">Tên đăng nhập</small>
                                <h5 class="fw-bold">@Model.TenDangNhap</h5>
                            </div>
                            <div class="mb-4">
                                <small class="text-muted fw-semibold d-block mb-2">Họ tên</small>
                                <h5>@(Model.HoTen ?? "Chưa cập nhật")</h5>
                            </div>
                            <div class="mb-4">
                                <small class="text-muted fw-semibold d-block mb-2">Số điện thoại</small>
                                <h5>@(Model.SoDienThoai ?? "Chưa cập nhật")</h5>
                            </div>
                            <div>
                                <small class="text-muted fw-semibold d-block mb-2">Email</small>
                                <h5>@(Model.Email ?? "Chưa cập nhật")</h5>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CỘT 2 -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100 rounded-3">
                        <div class="card-header bg-light border-bottom py-3">
                            <h6 class="fw-bold mb-0 text-success">Quyền & Địa chỉ</h6>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-4">
                                <small class="text-muted fw-semibold d-block mb-2">Chức vụ</small>
                                <span class="badge bg-primary px-4 py-2 fs-6 fw-bold">@(Model.ChucVu?.TenChucVu ?? "Khách hàng")</span>
                            </div>
                            <div class="mb-4">
                                <small class="text-muted fw-semibold d-block mb-2">Trạng thái</small>
                                <span class="badge @(Model.TrangThai ? "bg-success" : "bg-danger") px-4 py-2 fs-6 fw-bold">
                                    @(Model.TrangThai ? "Hoạt động" : "Bị khóa")
                                </span>
                            </div>
                            <div>
                                <small class="text-muted fw-semibold d-block mb-2">Địa chỉ</small>
                                <h6 class="text-dark">@(Model.DiaChi ?? "Chưa cập nhật")</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

           
            <!-- BUTTONS -->
            <div class="text-center">
                <div class="d-flex flex-wrap gap-2 justify-content-center flex-lg-nowrap">
                    <a asp-action="SuaThongTinCaNhan" class="btn btn-primary px-5 py-3 fw-semibold shadow-sm">
                        Sửa thông tin
                    </a>
                    <a asp-action="DoiMatKhau" class="btn btn-warning px-5 py-3 fw-semibold shadow-sm">
                        Đổi mật khẩu
                    </a>
                    <a asp-controller="GioHang" asp-action="Index" class="btn btn-success px-5 py-3 fw-semibold shadow-sm">
                        Giỏ hàng
                    </a>
                    <a asp-controller="DonHang" asp-action="Index" class="btn btn-info px-5 py-3 fw-semibold shadow-sm">
                        Đơn hàng
                    </a>
                    
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto hide alerts after 5s
        setTimeout(() => {
            document.querySelectorAll('.alert').forEach(alert => {
                new bootstrap.Alert(alert).close();
            });
        }, 5000);
    </script>
}