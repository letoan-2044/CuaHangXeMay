@model WebsiteBanXeMay.Models.TaiKhoan
@{
    ViewData["Title"] = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/ThongTinTk.css" />
}
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="card-header bg-gradient-primary text-white p-5 text-center position-relative">
                    <div class="avatar-container position-absolute top-0 start-50 translate-middle-x mt-n5">
                        <div class="avatar bg-gradient-warning rounded-circle d-flex align-items-center justify-content-center shadow-lg">
                            <i class="fas fa-user fa-3x text-white"></i>
                        </div>
                    </div>
                   
                </div>

                <!-- Body -->
                <div class="card-body p-5">
                    <!-- 🔥 THÔNG BÁO SUCCESS/ERROR -->
                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="row g-4">
                        <!-- Cột 1: Thông tin cơ bản -->
                        <div class="col-md-6">
                            <div class="info-card h-100 p-4 border rounded-3 shadow-sm">
                                <h5 class="fw-bold mb-4 border-bottom pb-2">
                                    <i class="fas fa-id-card me-2 text-primary"></i>Thông tin cơ bản
                                </h5>

                                <div class="info-item mb-3">
                                    <label class="form-label fw-semibold text-muted">Mã tài khoản:</label>
                                    <div class="fw-bold text-primary fs-5">@Model.MaTaiKhoan</div>
                                </div>

                                <div class="info-item mb-3">
                                    <label class="form-label fw-semibold text-muted">Tên đăng nhập:</label>
                                    <div class="fw-bold text-dark">@Model.TenDangNhap</div>
                                </div>

                                <div class="info-item mb-3">
                                    <label class="form-label fw-semibold text-muted">Họ tên:</label>
                                    <div>@(Model.HoTen ?? "<i class='text-muted'>Chưa cập nhật</i>")</div>
                                </div>

                                <div class="info-item mb-3">
                                    <label class="form-label fw-semibold text-muted">Số điện thoại:</label>
                                    <div>@(Model.SoDienThoai ?? "<i class='text-muted'>Chưa cập nhật</i>")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Cột 2: Quyền & Trạng thái -->
                        <div class="col-md-6">
                            <div class="info-card h-100 p-4 border rounded-3 shadow-sm">
                                <h5 class="fw-bold mb-4 border-bottom pb-2">
                                    <i class="fas fa-shield-alt me-2 text-success"></i>Quyền & Trạng thái
                                </h5>

                                <div class="info-item mb-3">
                                    <label class="form-label fw-semibold text-muted">Chức vụ:</label>
                                    @{
                                        string badgeClass = Model.MaChucVu switch
                                        {
                                            1 => "bg-danger",
                                            2 => "bg-info",
                                            _ => "bg-success"
                                        };
                                    }
                                    <span class="badge @badgeClass px-4 py-3 fs-6 fw-semibold">
                                        @(Model.ChucVu?.TenChucVu ?? "Khách hàng")
                                    </span>
                                </div>

                                <div class="info-item mb-3">
                                    <label class="form-label fw-semibold text-muted">Trạng thái:</label>
                                    <span class="badge @(Model.TrangThai ? "bg-success" : "bg-danger") px-4 py-3 fs-6 fw-semibold">
                                        @(Model.TrangThai ? "✅ Hoạt động" : "🚫 Bị khóa")
                                    </span>
                                </div>

                                <div class="info-item mb-3">
                                    <label class="form-label fw-semibold text-muted">Địa chỉ:</label>
                                    <div class="text-wrap">@(Model.DiaChi ?? "<i class='text-muted'>Chưa cập nhật</i>")</div>
                                </div>

                                <div class="info-item">
                                    <label class="form-label fw-semibold text-muted">Email:</label>
                                    <div>@(Model.Email ?? "<i class='text-muted'>Chưa cập nhật</i>")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 🔥 FOOTER BUTTONS - NÚT SỬA HOẠT ĐỘNG -->
                <div class="card-footer bg-light text-center py-4">
                    <a asp-action="QuanLyTaiKhoan" class="btn btn-outline-secondary me-3">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
                    </a>
                    <a asp-action="SuaThongTin" asp-route-id="@Model.MaTaiKhoan" class="btn btn-primary">
                        <i class="fas fa-edit me-2"></i>Sửa thông tin
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
