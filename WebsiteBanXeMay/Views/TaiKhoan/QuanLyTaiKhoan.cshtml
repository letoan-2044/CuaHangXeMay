@model dynamic
@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 🔥 ÉP KIỂU CHÍNH XÁC
    var taiKhoans = ViewBag.TaiKhoans as List<WebsiteBanXeMay.Models.TaiKhoan> ?? new List<WebsiteBanXeMay.Models.TaiKhoan>();
    int totalItems = (int)(ViewBag.TotalItems ?? 0);
    int currentPage = (int)(ViewBag.CurrentPage ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 10);
}

<div class="container-fluid py-4">
    <!-- 🔥 DEBUG INFO (XÓA SAU KHI TEST OK) -->
    <div class="alert alert-info">
        <strong>DEBUG:</strong>
        Tải @taiKhoans.Count()/@totalItems tài khoản |
        Trang @currentPage |
        Tìm: @ViewBag.Search |
        Trạng thái: @ViewBag.TrangThai
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="card-header bg-white border-bottom shadow-sm p-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="mb-0 fw-bold fs-3" style="color: #0d6efd !important;">
                                <i class="fas fa-users me-3" style="color: #0d6efd !important;"></i>
                                <span style="color: #0d6efd !important; font-weight: 700;">Quản lý tài khoản</span>
                            </h2>
                            <small style="color: #6c757d !important;">Tổng: <strong>@totalItems</strong> tài khoản</small>
                        </div>
                    </div>
                </div>

                <!-- Search & Filter -->
                <div class="card-body border-bottom p-4">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">🔍 Tìm kiếm</label>
                            <input name="search" class="form-control" value="@ViewBag.Search"
                                   placeholder="Tên ĐN, họ tên, SĐT...">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">📋 Trạng thái</label>
                            <select name="trangThai" class="form-select">
                                <option value="">Tất cả</option>
                                <option value="1" selected="@(ViewBag.TrangThai?.ToString() == "1")">✅ Hoạt động</option>
                                <option value="0" selected="@(ViewBag.TrangThai?.ToString() == "0")">❌ Khóa</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100 mt-auto">
                                <i class="fas fa-search"></i> Tìm
                            </button>
                        </div>
                        <div class="col-md-3">
                            <a asp-action="QuanLyTaiKhoan" class="btn btn-outline-secondary w-100 mt-auto">
                                <i class="fas fa-redo"></i> Làm mới
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th width="60" class="text-center">#</th>
                                <th>Tài khoản</th>
                                <th>Thông tin</th>
                                <th width="120">Chức vụ</th>
                                <th width="120">Trạng thái</th>
                                <th width="180">Email</th>
                                <th width="200">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (taiKhoans.Any())
                            {
                                int stt = (currentPage - 1) * pageSize + 1;
                                @foreach (var tk in taiKhoans)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@stt</td>
                                        <td>
                                            <strong>@tk.TenDangNhap</strong><br />
                                            <small class="text-muted">ID: @tk.MaTaiKhoan</small>
                                        </td>
                                        <td>
                                            <div>@(tk.HoTen ?? "N/A")</div>
                                            <div class="text-muted">@(tk.SoDienThoai ?? "-")</div>
                                            <small>@(tk.DiaChi ?? "")</small>
                                        </td>
                                        <td>
                                            @{
                                                string badgeClass = tk.MaChucVu switch
                                                {
                                                    1 => "bg-danger",
                                                    2 => "bg-info",
                                                    _ => "bg-success"
                                                };
                                                string tenChucVu = tk.ChucVu?.TenChucVu ?? "Khách hàng";
                                            }
                                            <span class="badge @badgeClass px-3 py-2">@tenChucVu</span>
                                        </td>
                                        <td>
                                            <span class="badge @(tk.TrangThai ? "bg-success" : "bg-danger") px-3 py-2 status-badge"
                                                  data-id="@tk.MaTaiKhoan" data-status="@(tk.TrangThai ? 1 : 0)">
                                                @(tk.TrangThai ? "✅ Hoạt động" : "❌ Khóa")
                                            </span>
                                        </td>
                                        <td>@(tk.Email ?? "-")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" onclick="viewDetail(@tk.MaTaiKhoan)">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn @(tk.TrangThai ? "btn-outline-danger" : "btn-outline-success") toggle-status"
                                                        data-id="@tk.MaTaiKhoan">
                                                    <i class="fas @(tk.TrangThai ? "fa-lock" : "fa-unlock")"></i>
                                                </button>
                                                @if (tk.MaChucVu != 1)
                                                {
                                                    <button class="btn btn-outline-danger delete-btn"
                                                            data-id="@tk.MaTaiKhoan" data-name="@tk.TenDangNhap">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                                        <h5>Không có tài khoản nào</h5>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalItems > pageSize)
                {
                    <div class="card-footer">
                        <nav>
                            <ul class="pagination justify-content-center mb-0">
                                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="?page=@i&search=@ViewBag.Search&trangThai=@ViewBag.TrangThai">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function viewDetail(id) {
            window.location = '/TaiKhoan/ThongTin?id=' + id;
        }

        $(function(){
            // Toggle status
            $('.toggle-status').click(function(){
                var id = $(this).data('id');
                var token = $('input[name="__RequestVerificationToken"]').val();
                var $btn = $(this);
                var isActive = $btn.find('i').hasClass('fa-lock');

                        Swal.fire({
                        title: isActive ? '🔒 Khóa tài khoản?' : '✅ Kích hoạt tài khoản?',
                        text: isActive ?
                            'Tài khoản này sẽ bị KHÓA và không thể đăng nhập!' :
                            'Tài khoản này sẽ được KÍCH HOẠT và có thể đăng nhập bình thường!',
                        icon: isActive ? 'warning' : 'question',
                        showCancelButton: true,
                        confirmButtonText: isActive ? 'Khóa ngay' : 'Kích hoạt',
                        confirmButtonColor: isActive ? '#dc3545' : '#28a745'
                    }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('/TaiKhoan/ToggleTrangThai', {
                            __RequestVerificationToken: token,
                            maTaiKhoan: id
                        }, function(data){
                            if(data.success) {
                                location.reload();
                            } else {
                                Swal.fire('Lỗi!', 'Không thể cập nhật!', 'error');
                            }
                        });
                    }
                });
            });

            // Delete
            $('.delete-btn').click(function(){
                var id = $(this).data('id');
                var name = $(this).data('name');
                var token = $('input[name="__RequestVerificationToken"]').val();

                Swal.fire({
                    title: 'Xóa tài khoản "' + name + '"?',
                    text: "Tài khoản sẽ bị xóa vĩnh viễn!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa ngay'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('/TaiKhoan/XoaTaiKhoan', {
                            __RequestVerificationToken: token,
                            maTaiKhoan: id
                        }, function(data){
                            if(data.success) {
                                location.reload();
                            } else {
                                Swal.fire('Lỗi!', 'Không thể xóa!', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}