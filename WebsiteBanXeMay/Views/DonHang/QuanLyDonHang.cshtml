@model List<DonHang>
<form id="anti-forgery" style="display: none;">
    @Html.AntiForgeryToken()
</form>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}
@section Styles {
    <link rel="stylesheet" href="~/css/DonHang.css" asp-append-version="true" />
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary">
        <i class="fas fa-shopping-bag me-2"></i>Quản lý đơn hàng
    </h2>
    <a href="#" class="btn btn-info btn-stats" onclick="donHangManager.loadStats(); return false;">
        <i class="fas fa-chart-bar me-1"></i>Thống kê
    </a>
</div>

<!-- FILTER -->
<div class="card search-filter-card shadow-lg mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <input type="text" name="tuKhoa" class="form-control"
                       placeholder="🔍 Tên KH/Mã ĐH" value="@ViewBag.TuKhoa">
            </div>
            <div class="col-md-2">
                <select name="trangThai" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="Chờ xử lý" selected="@(ViewBag.TrangThai == "Chờ xử lý")">⏳ Chờ xử lý</option>
                    <option value="Đang giao" selected="@(ViewBag.TrangThai == "Đang giao")">🚚 Đang giao</option>
                    <option value="Đã giao" selected="@(ViewBag.TrangThai == "Đã giao")">✅ Đã giao</option>
                    <option value="Hủy" selected="@(ViewBag.TrangThai == "Hủy")">❌ Hủy</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> Tìm
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="QuanLyDonHang" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-refresh"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- TABLE -->
<div class="card shadow-xl">
    <div class="card-header bg-gradient-primary text-white p-4">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="mb-0 fw-bold text-dark">
                    <i class="fas fa-list me-2"></i>@Model.Count() đơn hàng
                </h5>
            </div>
            <div class="col-auto">
                <span class="badge bg-success fs-6 px-4 py-2 fw-bold">
                    💰 @((ViewBag.TongDoanhThu ?? 0).ToString("N0"))đ
                </span>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-donhang table-hover mb-0">
                <thead>
                    <tr>
                        <th width="80">Mã ĐH</th>
                        <th width="180">Khách hàng</th>
                        <th width="120">Ngày đặt</th>
                        <th width="120">Tổng tiền</th>
                        <th width="250">Sản phẩm</th>
                        <th width="120">Trạng thái</th>
                        <th width="180">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dh in Model)
                    {
                        <tr data-dh="@dh.MaDonHang">
                            <td><span class="badge bg-primary fs-6">#@dh.MaDonHang</span></td>
                            <td>
                                <strong>@dh.TaiKhoan?.HoTen</strong>
                                <br><small>@dh.SoDienThoai</small>
                            </td>
                            <td>@dh.NgayDat.ToString("dd/MM HH:mm")</td>
                            <td>
                                <strong class="text-success">@((dh.TongTien ?? 0).ToString("N0"))đ</strong>
                            </td>
                            <td>
                                @foreach (var ct in dh.ChiTietDonHangs!.Take(2))
                                {
                                    <div class="mb-1 small">
                                        <i class="fas fa-motorcycle text-warning me-1"></i>
                                        @ct.SanPham?.TenSanPham (@ct.SoLuong)
                                    </div>
                                }
                                @if (dh.ChiTietDonHangs!.Count > 2)
                                {
                                    <small class="text-muted">+@(dh.ChiTietDonHangs.Count - 2)</small>
                                }
                            </td>
                            <td>
                                @{
                                    var trangThaiClass = dh.TrangThai?.Trim()?.ToLower()?.Replace(" ", "-")?.Replace("đã-giao", "da-giao") ?? "cho-xu-ly";
                                }
                                <span class="badge trạng-thái-@trangThaiClass fs-6 px-3 py-2 fw-bold badge-trangthai">
                                    @(dh.TrangThai ?? "Chờ xử lý")
                                </span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="ChiTiet" asp-route-id="@dh.MaDonHang"
                                       class="btn btn-outline-primary" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button class="btn btn-outline-success btn-capnhat"
                                            data-id="@dh.MaDonHang" data-trangthai="Đang giao" title="Giao">
                                        <i class="fas fa-truck"></i>
                                    </button>
                                    <button class="btn btn-outline-warning btn-capnhat"
                                            data-id="@dh.MaDonHang" data-trangthai="Đã giao" title="Hoàn thành">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-capnhat"
                                            data-id="@dh.MaDonHang" data-trangthai="Hủy" title="Hủy">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- MODAL THỐNG KÊ -->
        <div class="modal fade" id="statsModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header bg-gradient-primary text-white">
                        <h5 class="modal-title">
                            <i class="fas fa-chart-bar me-2"></i>Thống kê đơn hàng
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card bg-primary text-white h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-shopping-bag fa-3x mb-3 opacity-75"></i>
                                        <h3 id="totalOrders" class="mb-1">0</h3>
                                        <p class="mb-0">Tổng đơn</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-success text-white h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-dollar-sign fa-3x mb-3 opacity-75"></i>
                                        <h3 id="totalRevenue" class="mb-1">0đ</h3>
                                        <p class="mb-0">Doanh thu</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-warning text-white h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-clock fa-3x mb-3 opacity-75"></i>
                                        <h3 id="pendingOrders" class="mb-1">0</h3>
                                        <p class="mb-0">Chờ xử lý</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-info text-white h-100">
                                    <div class="card-body text-center">
                                        <i class="fas fa-check-circle fa-3x mb-3 opacity-75"></i>
                                        <h3 id="completedOrders" class="mb-1">0</h3>
                                        <p class="mb-0">Đã hoàn thành</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <canvas id="chartStatus"></canvas>
                            </div>
                            <div class="col-md-6">
                                <canvas id="chartRevenue"></canvas>
                            </div>
                        </div>

                        <div class="mt-4">
                            <div class="row text-center">
                                <div class="col-md-3">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h6>🚚 Đang giao</h6>
                                            <h4 id="shippingOrders" class="text-info mb-0">0</h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h6>❌ Hủy</h6>
                                            <h4 id="cancelledOrders" class="text-danger mb-0">0</h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h6>💰 TB đơn hàng</h6>
                                            <h4 id="avgOrder" class="text-success mb-0">0đ</h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h6>📊 Tỷ lệ hoàn thành</h6>
                                            <div class="d-flex align-items-center justify-content-center">
                                                <h4 id="completionRate" class="text-primary mb-0 me-2">0%</h4>
                                                <div class="progress" style="width: 60px; height: 20px;">
                                                    <div class="progress-bar bg-primary" id="completionBar" style="width: 0%"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" onclick="donHangManager.exportStats()">
                            <i class="fas fa-download me-1"></i>Xuất Excel
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Đóng
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- THÊM PHÂN TRANG Ở ĐÂY -->
        @if (ViewBag.TotalPages > 1)
        {
            @await Html.PartialAsync("_Pagination", new {
            currentPage = ViewBag.CurrentPage,
                totalPages = ViewBag.TotalPages
                })
                }
</div>
@section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <!-- ✅ Libraries -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <!-- 🔥 DONHANG.JS V3.0 - FULL FEATURES -->
        <script src="~/js/DonHang.js" asp-append-version="true"></script>

        <script>
            $(document).ready(function() {
                console.log('🚀 DonHang View + V3.0 READY!');

                // ✅ Test DonHangManager
                if (typeof window.donHangManager !== 'undefined') {
                    console.log('✅ DonHangManager V3.0 LOADED!');
                }
            });
        </script>
}
